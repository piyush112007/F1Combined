rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rules for the users collection
    match /users/{userId} {
      // Users can only read their own profile document
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Users can only write/update their own profile document
      // Validates that driverAvatarId must be a string if provided
      allow write: if request.auth != null && request.auth.uid == userId
                   && (!('driverAvatarId' in request.resource.data) || request.resource.data.driverAvatarId is string);
    }
  }
}
